# Python
__pycache__/
*.pyc
*.pyo
.venv/
.egg-info/
dist/
build/
*.egg
artifacts/

# Environment
.env
.env.*
!.env.example

# Node
node_modules/

# Terraform
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform.tfvars

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Security scans: detailed output is retained as a short-lived CI artifact.
# The deterministic current summary is the only security scan artifact reviewed
# and versioned through the readiness PR.
security-reports/bandit_*.json
security-reports/bandit_*.txt
security-reports/safety_*.json
security-reports/safety_*.txt
security-reports/security_audit_summary_*.md
!security-reports/security_audit_summary_current.md
# --- Hardonian bootstrap kit ---
# Hardonian standard ignores
!.env.template
venv/
target/
.coverage
htmlcov/

# --- Local test virtualenv (CI creates its own; never commit) ---
.venv-ci/

# --- Editable-install metadata: agent_factory.egg-info (the bare
#     `.egg-info/` pattern above does NOT match this name) ---
*.egg-info/

# --- Runtime SQLite state, regenerated by the app and rewritten on every
#     nightly/deps run; committing them churned every later diff ---
agent_factory/*.db
*.sqlite3

# detect-secrets local scratch (the baseline itself IS committed)
.secrets.baseline.raw
